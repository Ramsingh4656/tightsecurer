# Dependency directories
# Prevents node dependencies from being committed
node_modules/
jspm_packages/

# Package manager caches
# Ignores npm, Yarn, and pnpm caches
.npm/
.yarn/
.pnpm-store/

# Debug and runtime logs
# Ignores logs generated by npm, yarn, and the OS
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Operating System files
# Ignores standard OS metadata files that do not belong in a repository
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
desktop.ini

# IDEs and Editors
# Ignores editor preference folders while optionally preserving team settings
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/code-workspace

# Local Environment Files
# Prevents sensitive API keys and configuration from being committed
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
*.env

# Build and Output directories
# Ignores built bundles from standard frontend tools like Vite, Astro, Parcel, webpack, etc.
dist/
build/
out/
.astro/
.next/
.nuxt/
.docusaurus/
.cache/
.parcel-cache/
storybook-static/

# Testing and Coverage
# Ignores output directories from test runners
coverage/
.nyc_output/

# Cache and temporary files
# Ignores tool-specific caches and lint caches
.turbo/
.nx/
.eslintcache
.stylelintcache
*.tmp
*.bak
*.swp

# Source Maps
# Ignores generated source maps in production build environments
*.map

# Keep project assets and locks explicitly tracked
# These are unignored to make sure we don't accidentally match subdirectories
!package-lock.json
!assets/
!css/
!js/
!index.html
!README.md
